# Copy to .env. Matches compose.yaml's defaults.

# The application's database.
MERIDIAN_DATABASE_URL=postgresql+psycopg://meridian:meridian@localhost:5433/meridian

# The Platform's database — a separate database reached with a separate role, on the same
# server. Sharing the application's role would leave the Platform able to connect to the
# application's database directly, which is the boundary this URL exists to hold.
MERIDIAN_PLATFORM_DATABASE_URL=postgresql+psycopg://platform:platform@localhost:5433/platform

# Guards the admin surface over the source registry. Required — the app refuses to boot
# without one. Generate your own; this placeholder is not a usable secret.
#   openssl rand -hex 32
MERIDIAN_ADMIN_TOKEN=replace-me
